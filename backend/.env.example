# Copy this file to .env and fill in your Supabase project values.
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Server-side key (recommended; bypasses RLS). This is the secret / service-role key.
SUPABASE_SECRET_KEY=sb_secret_YOUR-SECRET-KEY
# Or the legacy service-role key name still works:
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Public key used only as a fallback when no secret key is configured.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-PUBLISHABLE-KEY
# Or the legacy anon key name still works:
# SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Direct Postgres connection, used only by scripts/init_db.py to apply the schema.
DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# Staff-only admin dashboard at /admin
ADMIN_PASSWORD=CHANGE-ME-IN-PRODUCTION

# Mark the admin/CSRF cookies as Secure (only send over HTTPS).
# Set to true in production (Render provides TLS); keep false for local dev.
# SECURE_COOKIES=true

# Comma-separated origins allowed to call the API (CORS).
# Defaults to local dev origins when not set. Add your Render URL in production:
# ALLOWED_ORIGINS=https://galaxy-restaurants.onrender.com

# WhatsApp Business Cloud API (Meta) — optional; leave blank to disable.
# get these from your app dashboard at developers.facebook.com -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=EAAYOUR-TOKEN
WHATSAPP_PHONE_NUMBER_ID=1234567890123456
# Locale of your approved templates, e.g. en_US for "English (US)" or en_GB. Defaults to en_US.
# WHATSAPP_TEMPLATE_LANG=en_US